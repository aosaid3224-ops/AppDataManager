#!/bin/bash
set -e

HELPER_NAME="ipainstallerpro_helper"
# Check all possible locations (rootless and rootful)
POSSIBLE_PATHS=(
    "/usr/bin/${HELPER_NAME}"
    "/var/jb/usr/bin/${HELPER_NAME}"
)

INSTALLED_PATH=""

for p in "${POSSIBLE_PATHS[@]}"; do
    if [ -f "$p" ]; then
        INSTALLED_PATH="$p"
        break
    fi
done

if [ -z "$INSTALLED_PATH" ]; then
    echo "ERROR: ${HELPER_NAME} not found in expected locations"
    echo "Searched:"
    for p in "${POSSIBLE_PATHS[@]}"; do
        echo "  - $p"
    done
    exit 1
fi

# Set proper permissions for setuid root
echo "Setting setuid root on ${INSTALLED_PATH}..."
chmod 4755 "$INSTALLED_PATH"
chown root:wheel "$INSTALLED_PATH"

# Verify setuid bit is set
if [ -u "$INSTALLED_PATH" ]; then
    echo "✅ Helper setuid verified at ${INSTALLED_PATH}"
else
    echo "⚠️ WARNING: setuid bit not set on ${INSTALLED_PATH}"
    echo "Attempting alternative method..."
    # Try with explicit permission
    chmod u+s "$INSTALLED_PATH"
    if [ -u "$INSTALLED_PATH" ]; then
        echo "✅ Helper setuid set via u+s"
    else
        echo "❌ FAILED: Could not set setuid bit"
        exit 1
    fi
fi

# Verify helper is executable
if [ -x "$INSTALLED_PATH" ]; then
    echo "✅ Helper is executable"
else
    echo "❌ Helper is not executable"
    exit 1
fi

echo "IPA Installer Pro helper installed successfully"
exit 0

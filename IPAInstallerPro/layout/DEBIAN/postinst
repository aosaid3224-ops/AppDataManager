#!/bin/bash
set -e

HELPER_NAME="ipainstallerpro_helper"
# Check all possible locations (rootless and rootful)
POSSIBLE_PATHS=(
    "/usr/bin/${HELPER_NAME}"
    "/var/jb/usr/bin/${HELPER_NAME}"
)

INSTALLED_PATH=""

# Remove only interrupted-install staging directories. The shell glob follows
# an Applications symlink into the active Procursus root, while the exact name
# pattern and direct-child scope prevent touching normal apps or user data.
# This runs during package configuration, not during an active IPA transaction.
STAGE_ROOTS=(
    "/var/jb/Applications"
    "/Applications"
    "/var/jb/var/tmp/IPAInstallerPro-Staging"
    "/var/tmp/IPAInstallerPro-Staging"
)
# uicache resolves /var/jb/Applications before enumerating it. Add the
# physical target as well, because find/glob behavior differs across roots.
for logical_root in "/var/jb/Applications" "/Applications" "/var/jb/var/tmp/IPAInstallerPro-Staging" "/var/tmp/IPAInstallerPro-Staging"; do
    if [ -d "$logical_root" ]; then
        physical_root=$(cd "$logical_root" 2>/dev/null && pwd -P || true)
        if [ -n "$physical_root" ]; then
            STAGE_ROOTS+=("$physical_root")
        fi
    fi
done
# Dopamine may expose /var/jb through a namespace while uicache reports the
# backing path under /private/preboot/<uuid>/dopamine-*/procursus. Enumerate
# that backing root explicitly; the glob is expanded by the shell and is not
# passed to rm as a pattern.
for physical_root in /private/preboot/*/dopamine-*/procursus/Applications; do
    [ -d "$physical_root" ] || continue
    STAGE_ROOTS+=("$physical_root")
done
for stage_root in "${STAGE_ROOTS[@]}"; do
    for stage_path in "$stage_root"/*.app.ipa-stage-*; do
        [ -d "$stage_path" ] || continue
        /bin/rm -rf -- "$stage_path" 2>/dev/null || true
    done
done

for p in "${POSSIBLE_PATHS[@]}"; do
    if [ -f "$p" ]; then
        INSTALLED_PATH="$p"
        break
    fi
done

if [ -z "$INSTALLED_PATH" ]; then
    echo "ERROR: ${HELPER_NAME} not found in expected locations"
    echo "Searched:"
    for p in "${POSSIBLE_PATHS[@]}"; do
        echo "  - $p"
    done
    exit 1
fi

# Set proper permissions for setuid root
echo "Setting setuid root on ${INSTALLED_PATH}..."
chmod 4755 "$INSTALLED_PATH"
chown root:wheel "$INSTALLED_PATH"

# Verify setuid bit is set
if [ -u "$INSTALLED_PATH" ]; then
    echo "✅ Helper setuid verified at ${INSTALLED_PATH}"
else
    echo "⚠️ WARNING: setuid bit not set on ${INSTALLED_PATH}"
    echo "Attempting alternative method..."
    # Try with explicit permission
    chmod u+s "$INSTALLED_PATH"
    if [ -u "$INSTALLED_PATH" ]; then
        echo "✅ Helper setuid set via u+s"
    else
        echo "❌ FAILED: Could not set setuid bit"
        exit 1
    fi
fi

# Verify helper is executable
if [ -x "$INSTALLED_PATH" ]; then
    echo "✅ Helper is executable"
else
    echo "❌ Helper is not executable"
    exit 1
fi

echo "IPA Installer Pro helper installed successfully"
exit 0

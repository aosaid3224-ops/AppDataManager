#!/bin/bash
set -e

echo "=========================================="
echo " 📱 AppData Manager v1.4.0"
echo " Dopamine 3.0 / Rootless Compatible"
echo "=========================================="

JB_ROOT="/var/jb"
if [ ! -d "$JB_ROOT" ]; then
    JB_ROOT=""
fi

APP_PATH="${JB_ROOT}/Applications/AppDataManager.app"

BACKUP_DIR="/var/mobile/Documents/AppDataBackups"
if [ ! -d "$BACKUP_DIR" ]; then
    mkdir -p "$BACKUP_DIR"
    chown mobile:mobile "$BACKUP_DIR"
    chmod 755 "$BACKUP_DIR"
    echo "✅ Backup directory created at $BACKUP_DIR"
fi

if command -v uicache &> /dev/null; then
    echo "🔄 Updating icon cache..."
    if [ -d "$APP_PATH" ]; then
        uicache -p "$APP_PATH" 2>/dev/null || true
    else
        uicache -p /Applications/AppDataManager.app 2>/dev/null || true
    fi
    echo "✅ Icon cache updated"
fi

if [ -d "$APP_PATH" ]; then
    chown -R root:wheel "$APP_PATH"
    chmod 755 "$APP_PATH"
    chmod +x "$APP_PATH/AppDataManager" 2>/dev/null || true
fi

echo ""
echo "✅ Installation Complete!"
echo "📲 Open 'AppData Manager' from your home screen"
echo ""

exit 0
